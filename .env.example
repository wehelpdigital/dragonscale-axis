APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# MEDIA_DISK=s3 puts the public disk -- every upload, this app's and AniSystem's -- on the bucket the AWS_* values describe (Laravel Cloud injects them). Leave unset on a host with a volume.
MEDIA_DISK=
# Set to 1 to serve bucket files through signed links even when AWS_URL is set (for a bucket whose public address is not live yet).
MEDIA_SIGNED_LINKS=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# The secret AniSystem presents when storing media here.
ANISYSTEM_MEDIA_TOKEN=

# Games > Salpakan Tactics! (config/games.php). The game server's address and the
# token it checks on /api/axis/v1/* (the same secret the game server is set up with).
SALPAKAN_API_URL=https://games-of-the-generals-web-production-6zraos.laravel.cloud
SALPAKAN_SYNC_TOKEN=
# Peso rate a game order is logged into /ecom-orders at (the Settings page can override it).
SALPAKAN_USD_TO_PHP_RATE=58

# Acumbamail (config/services.php): the account's auth token, and the list Salpakan players join.
ACUMBAMAIL_API_KEY=
ACUMBAMAIL_SALPAKAN_LIST_ID=1571430
# 1 = Acumbamail asks each new subscriber to confirm by email before they are on the list.
ACUMBAMAIL_DOUBLE_OPTIN=0
